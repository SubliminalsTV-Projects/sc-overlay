new file mode 100644
index 0000000..1a48757
--- /dev/null
+++ b/test/r31-alpha14-resource-budget.test.cjs
@@ -0,0 +1,54 @@
+"use strict";
+
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+
+const root = process.argv[2] || path.resolve(__dirname, "..");
+const sourceLayout = fs.existsSync(path.join(root, "electron/capture.cjs"));
+const read = (sourceFile, packagedFile) => fs.readFileSync(path.join(root, sourceLayout ? sourceFile : packagedFile), "utf8");
+const capture = read("electron/capture.cjs", "app/electron/capture.cjs");
+const rapidClient = read("electron/rapidocr-client.cjs", "app/electron/rapidocr-client.cjs");
+const rapidWorker = read("electron/rapidocr-worker.cjs", "app/electron/rapidocr-worker.cjs");
+const main = read("electron/main.cjs", "app/electron/main.cjs");
+const configPage = read("overlay/config.html", "app/server/overlay/config.html");
+const server = read("src/overlay-server.ts", "app/server/sc-overlay-server.mjs");
+
+// Settings, sidecar, Electron, and the capture loop must share one physical config path.
+assert.match(server, /const userDir = process\.env\.SC_TRACKER_CONFIG_DIR \|\| legacyUserDir/);
+assert.match(server, /migrateAlpha13ConfigPath\(\)/);
+assert.match(server, /config\.alpha13-legacy\.bak\.json/);
+assert.match(server, /config_save_failed/);
+assert.match(server, /configPath,[\s\S]*screenReading:/);
+assert.match(configPage, /saved values did not verify/);
+assert.match(configPage, /applied\.miningAssistant === body\.miningAssistant/);
+assert.match(configPage, /add\("Config file", d\.data\.configPath/);
+
+// Native libraries are bounded independently so nested thread pools cannot consume the host.
+assert.match(capture, /OMP_THREAD_LIMIT: process\.env\.OMP_THREAD_LIMIT \|\| "1"/);
+assert.match(capture, /MAGICK_THREAD_LIMIT: process\.env\.MAGICK_THREAD_LIMIT \|\| "1"/);
+assert.match(rapidClient, /SC_TRACKER_OCR_THREADS: process\.env\.SC_TRACKER_OCR_THREADS \|\| "2"/);
+assert.match(rapidClient, /RapidOCR latest-frame queue is full/);
+assert.match(rapidWorker, /intraOpNumThreads: OCR_THREADS/);
+assert.match(rapidWorker, /interOpNumThreads: 1/);
+assert.match(rapidWorker, /executionMode: "sequential"/);
+assert.match(rapidWorker, /setPriority\(0, 10\)/);
+
+// The missing Alpha 13 template assets no longer force an always-inactive detector. One bounded
+// angle read opens the state machine; analysis/signature work is forbidden while it is dormant.
+assert.match(capture, /rapidocr-angle-gate/);
+assert.match(capture, /selected = hinted\.find\(\(row\) => Number\(row\.score\) >= 0\.70\)/);
+assert.match(capture, /miningLikelyActive && shouldRunVisualStage\("mining-analysis"/);
+assert.match(capture, /if \(miningLikelyActive && analysisRead\.kind !== "mining-analysis"/);
+assert.match(capture, /mining-signature-inactive/);
+assert.doesNotMatch(capture, /slow safety probe otherwise/);
+assert.doesNotMatch(capture, /maxAgeMs: miningLikelyActive \? 3500 : 15_000/);
+assert.match(capture, /return boxes\.slice\(0, 4\)/);
+assert.doesNotMatch(capture, /psm: 13, whitelist: "0123456789,\."/);
+
+// Preserve the interaction ownership contract proven in Alpha 12 and retained in Alpha 13.
+assert.match(main, /overlayInteractionLatched = true/);
+assert.match(main, /coordinate misses never/);
+assert.doesNotMatch(main, /pointer left classified widget/);
+
+console.log("r31 alpha 14 config-path, OCR-budget, and interaction contract test: passed");
