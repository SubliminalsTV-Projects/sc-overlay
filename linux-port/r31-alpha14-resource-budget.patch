diff --git a/test/alpha14-config-e2e.cjs b/test/alpha14-config-e2e.cjs
new file mode 100644
index 0000000..7b3cf4f
--- /dev/null
+++ b/test/alpha14-config-e2e.cjs
@@ -0,0 +1,101 @@
+"use strict";
+
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const os = require("node:os");
+const path = require("node:path");
+const { spawn } = require("node:child_process");
+
+const root = path.resolve(process.argv[2] || path.join(__dirname, ".."));
+const serverPath = [
+  path.join(root, "build/server/sc-overlay-server.mjs"),
+  path.join(root, "app/server/sc-overlay-server.mjs"),
+].find((candidate) => fs.existsSync(candidate));
+assert.ok(serverPath, "built sidecar is required for the Alpha 14 config end-to-end test");
+
+const temp = fs.mkdtempSync(path.join(os.tmpdir(), "archverse-alpha14-config-"));
+const home = path.join(temp, "home");
+const canonicalDir = path.join(temp, "xdg", "sc-blueprint-tracker");
+const legacyDir = path.join(home, "sc-blueprint-tracker");
+fs.mkdirSync(canonicalDir, { recursive: true });
+fs.mkdirSync(legacyDir, { recursive: true });
+
+// Reproduce the Alpha 13 split: OCR reads canonical/all-on while Settings writes legacy/mining.
+fs.writeFileSync(path.join(canonicalDir, "config.json"), JSON.stringify({
+  urls: [], missionOcr: true, miningAssistant: true, fabCapture: true,
+  screenReaderProfile: "custom", syncEnabled: false,
+}));
+fs.writeFileSync(path.join(legacyDir, "config.json"), JSON.stringify({
+  urls: [], missionOcr: false, miningAssistant: true, fabCapture: false,
+  screenReaderProfile: "mining", syncEnabled: false,
+}));
+
+const port = 19000 + (process.pid % 1000);
+const env = {
+  ...process.env,
+  HOME: home,
+  PORT: String(port),
+  APP_VERSION: "0.1.36-r31-alpha.14-test",
+  SC_TRACKER_CONFIG_DIR: canonicalDir,
+};
+delete env.APPDATA;
+const logs = [];
+const child = spawn(process.execPath, [serverPath], { cwd: path.dirname(serverPath), env, stdio: ["ignore", "pipe", "pipe"] });
+child.stdout.on("data", (chunk) => logs.push(String(chunk)));
+child.stderr.on("data", (chunk) => logs.push(String(chunk)));
+
+const base = `http://127.0.0.1:${port}`;
+async function waitForServer() {
+  const deadline = Date.now() + 15_000;
+  while (Date.now() < deadline) {
+    if (child.exitCode !== null) throw new Error(`sidecar exited early (${child.exitCode})\n${logs.join("")}`);
+    try {
+      const response = await fetch(`${base}/api/config`);
+      if (response.ok) return response.json();
+    } catch { /* startup */ }
+    await new Promise((resolve) => setTimeout(resolve, 100));
+  }
+  throw new Error(`sidecar did not start\n${logs.join("")}`);
+}
+
+(async () => {
+  try {
+    const migrated = await waitForServer();
+    assert.equal(migrated.configPath, path.join(canonicalDir, "config.json"));
+    assert.equal(migrated.screenReaderProfile, "mining");
+    assert.equal(migrated.missionOcr, false);
+    assert.equal(migrated.miningAssistant, true);
+    assert.equal(migrated.fabCapture, false);
+    assert.ok(fs.existsSync(path.join(canonicalDir, "config.alpha13-legacy.bak.json")));
+
+    const response = await fetch(`${base}/api/config`, {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({
+        screenReaderProfile: "lightweight",
+        missionOcr: false,
+        miningAssistant: false,
+        fabCapture: false,
+      }),
+    });
+    const applied = await response.json();
+    assert.equal(response.status, 200);
+    assert.deepEqual(applied.screenReading, {
+      profile: "lightweight",
+      fabCapture: false,
+      missionOcr: false,
+      miningAssistant: false,
+    });
+
+    const persisted = JSON.parse(fs.readFileSync(path.join(canonicalDir, "config.json"), "utf8"));
+    assert.equal(persisted.screenReaderProfile, "lightweight");
+    assert.equal(persisted.miningAssistant, false);
+    console.log("r31 alpha 14 config path end-to-end test: passed");
+  } finally {
+    child.kill("SIGTERM");
+    fs.rmSync(temp, { recursive: true, force: true });
+  }
+})().catch((error) => {
+  console.error(error?.stack || error);
+  process.exitCode = 1;
+});
