@@ -0,0 +1,47 @@
+"use strict";
+
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+
+const root = process.argv[2] || path.resolve(__dirname, "..");
+const sourceLayout = fs.existsSync(path.join(root, "electron/main.cjs"));
+const read = (sourceFile, packagedFile) =>
+  fs.readFileSync(path.join(root, sourceLayout ? sourceFile : packagedFile), "utf8");
+
+const main = read("electron/main.cjs", "app/electron/main.cjs");
+const hotkeys = read("electron/hotkeys.cjs", "app/electron/hotkeys.cjs");
+const browser = read("electron/browser-widget.cjs", "app/electron/browser-widget.cjs");
+const capture = read("electron/capture.cjs", "app/electron/capture.cjs");
+const scanGate = read("electron/scan-mode-gate.cjs", "app/electron/scan-mode-gate.cjs");
+
+// The low-level hook observes physical button down/up, not just pointer movement. Main delays its
+// fallback briefly, accepts a correctly positioned native event, and otherwise injects an explicit
+// move/down/up sequence into the correct WebContents.
+assert.match(hotkeys, /uio\.on\("mousedown", \(event\) => onMousebutton\("down", event\)\)/);
+assert.match(hotkeys, /uio\.on\("mouseup", \(event\) => onMousebutton\("up", event\)\)/);
+assert.match(hotkeys, /function onMouseButton\(cb\)/);
+assert.match(hotkeys, /module\.exports = \{[^}]*onMouseButton[^}]*\}/);
+assert.match(main, /stopMouseButtonWatch = hotkeys\.onMouseButton/);
+assert.match(main, /F_CLICK_NATIVE_GRACE_MS = 28/);
+assert.match(main, /nativeMouseReachedTarget\(type, button, canvasPoint, startedAt\)/);
+assert.match(main, /dispatchInteractionMouse\(destination, "mouseMove"/);
+assert.match(main, /dispatchInteractionMouse\(destination, type, canvasPoint, button/);
+assert.match(main, /\[f-click\].*forwarded/);
+assert.match(main, /releaseForwardedMouseButtons\(reason\)/);
+assert.match(main, /webContents\.on\("before-mouse-event"/);
+assert.match(browser, /mouseDestinationAt\(point\)/);
+assert.match(browser, /onNativeMouse/);
+
+// The old visible second-pointer window is gone completely.
+assert.doesNotMatch(main, /INTERACTION_CURSOR_HTML|ensureInteractionCursorWindow|interactionCursorWin/);
+
+// Scan activation depends only on a shared radar-icon match in a broad normalized field.
+assert.match(scanGate, /SCAN_MODE_RADAR_SEARCH_ROI/);
+assert.match(scanGate, /RADAR_REFERENCE_BITS/);
+assert.match(scanGate, /method: "radar-icon-template-search"/);
+assert.match(capture, /detectScanModeRadarIcon/);
+assert.doesNotMatch(scanGate, /prospector/i);
+assert.doesNotMatch(capture, /prospector-hud-color/i);
+
+console.log("r31 alpha 16 radar-icon and physical click-forwarding test: passed");
