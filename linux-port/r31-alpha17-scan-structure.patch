@@ -0,0 +1,92 @@
+"use strict";
+
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+
+const root = process.argv[2] || path.resolve(__dirname, "..");
+const sourceLayout = fs.existsSync(path.join(root, "electron/scan-mode-gate.cjs"));
+const source = (file) => path.join(root, sourceLayout ? file : `app/${file}`);
+const scanGateSource = fs.readFileSync(source("electron/scan-mode-gate.cjs"), "utf8");
+const captureSource = fs.readFileSync(source("electron/capture.cjs"), "utf8");
+const { detectScanModeRadarIcon } = require(source("electron/scan-mode-gate.cjs"));
+
+// The search field comes from the user's paired 6360x2560 on/off frames and #ff0000 outlines,
+// converted to the 3840x2160 primary game frame with a normalized safety margin. It is a universal
+// Scan HUD field, not a ship, color, ping, target, or fixed-resolution dependency.
+assert.match(scanGateSource, /x: 0\.37/);
+assert.match(scanGateSource, /y: 0\.41/);
+assert.match(scanGateSource, /w: 0\.32/);
+assert.match(scanGateSource, /h: 0\.30/);
+assert.match(scanGateSource, /iconRecall/);
+assert.match(scanGateSource, /labelRecall/);
+assert.match(scanGateSource, /haloDensity/);
+assert.match(scanGateSource, /missing-angle-label/);
+assert.match(scanGateSource, /match-not-isolated/);
+assert.match(scanGateSource, /radar-icon-structure-search/);
+assert.doesNotMatch(scanGateSource, /prospector/i);
+
+// Diagnostics retain the exact match and its context, save on match changes/active refreshes, and
+// expose every structural score in the runtime log instead of only the ambiguous aggregate score.
+assert.match(captureSource, /match-context-\$\{recentSlot\}\.jpg/);
+assert.match(captureSource, /scan-mode-match-change/);
+assert.match(captureSource, /scan-mode-active-refresh/);
+assert.match(captureSource, /scanModeRead\.iconRecall/);
+assert.match(captureSource, /scanModeRead\.labelRecall/);
+assert.match(captureSource, /scanModeRead\.haloDensity/);
+assert.match(captureSource, /scanModeRead\.rejectionReason/);
+
+const WIDTH = 960;
+const HEIGHT = 540;
+const fixtures = [
+  {
+    name: "Alpha 16 changelog button false positive",
+    x: 480, y: 300, w: 80, h: 80, active: false,
+    bits: "",
+  },
+  {
+    name: "Alpha 16 hangar beam false positive",
+    x: 480, y: 200, w: 80, h: 80, active: false,
+    bits: "",
+  },
+  {
+    name: "outlined Scan Mode off",
+    x: 455, y: 210, w: 80, h: 80, active: false,
+    bits: "",
+  },
+  {
+    name: "outlined Scan Mode on",
+    x: 415, y: 250, w: 80, h: 80, active: true,
+    bits: "",
+  },
+];
+
+function frameFromFixture(fixture) {
+  const frame = Buffer.alloc(WIDTH * HEIGHT * 4);
+  for (let pixel = 0; pixel < WIDTH * HEIGHT; pixel += 1) {
+    frame[pixel * 4] = 25;
+    frame[pixel * 4 + 1] = 35;
+    frame[pixel * 4 + 2] = 45;
+    frame[pixel * 4 + 3] = 255;
+  }
+  const packed = Buffer.from(fixture.bits, "base64");
+  for (let y = 0; y < fixture.h; y += 1) {
+    for (let x = 0; x < fixture.w; x += 1) {
+      const bit = y * fixture.w + x;
+      if (!((packed[bit >> 3] >> (bit & 7)) & 1)) continue;
+      const offset = ((fixture.y + y) * WIDTH + fixture.x + x) * 4;
+      frame[offset] = 20;
+      frame[offset + 1] = 210;
+      frame[offset + 2] = 240;
+    }
+  }
+  return frame;
+}
+
+for (const fixture of fixtures) {
+  const result = detectScanModeRadarIcon(frameFromFixture(fixture), WIDTH, HEIGHT);
+  assert.equal(result.active, fixture.active, `${fixture.name}: ${JSON.stringify(result)}`);
+  assert.equal(result.method, "radar-icon-structure-search");
+}
+
+console.log("r31 alpha 17 labeled Scan Mode structure regression test: passed");
