diff --git a/test/r31-alpha15-interaction-diagnostics.test.cjs b/test/r31-alpha15-interaction-diagnostics.test.cjs
new file mode 100644
index 0000000..db5a7a2
--- /dev/null
+++ b/test/r31-alpha15-interaction-diagnostics.test.cjs
@@ -0,0 +1,72 @@
+"use strict";
+
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+
+const root = process.argv[2] || path.resolve(__dirname, "..");
+const sourceLayout = fs.existsSync(path.join(root, "electron/main.cjs"));
+const read = (sourceFile, packagedFile) =>
+  fs.readFileSync(path.join(root, sourceLayout ? sourceFile : packagedFile), "utf8");
+
+const main = read("electron/main.cjs", "app/electron/main.cjs");
+const capture = read("electron/capture.cjs", "app/electron/capture.cjs");
+const scanGate = read("electron/scan-mode-gate.cjs", "app/electron/scan-mode-gate.cjs");
+const configPage = read("overlay/config.html", "app/server/overlay/config.html");
+const server = read("src/overlay-server.ts", "app/server/sc-overlay-server.mjs");
+
+// Linux F is a required safety/entry path. No migrated config value or live Settings IPC call may
+// disable it, while Windows retains the existing configurable hold-mode behavior.
+assert.doesNotMatch(main, /fHoverEnabled = c\.holdToInteract !== false/);
+assert.match(main, /if \(process\.platform === "linux"\) fHoverEnabled = true/);
+assert.match(main, /app:set-hold-mode[\s\S]*?if \(process\.platform === "linux"\) \{[\s\S]*?fHoverEnabled = true;[\s\S]*?return true;/);
+assert.match(configPage, /const IS_LINUX_DESKTOP = \/Linux\/i\.test/);
+assert.match(configPage, /holdControl\.disabled = IS_LINUX_DESKTOP/);
+assert.match(configPage, /holdToInteract: IS_LINUX_DESKTOP \? true/);
+assert.match(configPage, /setHotkeyDisplay\("interact", "F"\)/);
+assert.match(configPage, /interactHotkeyBtn"\)\.disabled = true/);
+assert.match(configPage, /IS_LINUX_DESKTOP && which === "interact"/);
+assert.match(server, /holdToInteract: true/);
+assert.match(server, /repaired mandatory Linux F interaction gate/);
+assert.match(server, /config\.interactHotkey = "F"/);
+assert.match(server, /process\.platform === "linux" \? true : body\.holdToInteract/);
+
+// Application-owned logs are timestamped, and OCR evidence uses a fixed-size ring so a later idle
+// frame cannot erase the Scan Mode failure that the user is trying to report.
+assert.match(main, /new Date\(\)\.toISOString\(\)/);
+assert.match(capture, /const OCR_DEBUG_RECENT_LIMIT = 8/);
+assert.match(capture, /ocrDebugSequence\+\+ % OCR_DEBUG_RECENT_LIMIT/);
+assert.match(capture, /`frame-\$\{recentSlot\}\.jpg`/);
+assert.match(capture, /`read-\$\{recentSlot\}\.json`/);
+
+// Three user-supplied frames establish that Scan Mode exists before a ping or selected target.
+// The detector uses the fixed cone control in memory and never depends on UNKNOWN/signature text.
+assert.match(scanGate, /prospector-cone-control/);
+assert.match(scanGate, /hudDensity >= 0\.012 && brightDensity >= 0\.0075/);
+assert.match(capture, /prospector-hud-color-gate/);
+assert.match(capture, /prospector-hud-color-absent/);
+assert.match(capture, /visualFingerprint\(shot, cap\.width, cap\.height, SCAN_MODE_HUD_GATE_ROI\)/);
+assert.doesNotMatch(capture, /method: selected \? "rapidocr-angle-gate"/);
+
+const { scoreScanModeHudBitmap } = require(path.join(root, sourceLayout
+  ? "electron/scan-mode-gate.cjs"
+  : "app/electron/scan-mode-gate.cjs"));
+const makeBitmap = (activePixels) => {
+  const bitmap = Buffer.alloc(100 * 100 * 4);
+  for (let i = 0; i < 100 * 100; i += 1) {
+    bitmap[i * 4] = 35;
+    bitmap[i * 4 + 1] = 45;
+    bitmap[i * 4 + 2] = 55;
+    bitmap[i * 4 + 3] = 255;
+  }
+  for (let i = 0; i < activePixels; i += 1) {
+    bitmap[i * 4] = 30;
+    bitmap[i * 4 + 1] = 185;
+    bitmap[i * 4 + 2] = 220;
+  }
+  return bitmap;
+};
+assert.equal(scoreScanModeHudBitmap(makeBitmap(20)).active, false);
+assert.equal(scoreScanModeHudBitmap(makeBitmap(200)).active, true);
+
+console.log("r31 alpha 15 Linux F and bounded OCR diagnostics test: passed");
