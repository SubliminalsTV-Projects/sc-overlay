diff --git a/electron/scan-mode-gate.cjs b/electron/scan-mode-gate.cjs
new file mode 100644
index 0000000..7b6b465
--- /dev/null
+++ b/electron/scan-mode-gate.cjs
@@ -0,0 +1,53 @@
+"use strict";
+
+// The Prospector's Scan Mode cone control is anchored just left of the center reticle. This tight
+// normalized crop was calibrated from three real game frames at 3840x2160 and 2048x1152:
+// normal mining cockpit, Scan Mode before any ping/target, and Scan Mode after a ping. The cone
+// control is present in both Scan Mode states and absent from the normal cockpit state.
+const SCAN_MODE_HUD_GATE_ROI = Object.freeze({
+  name: "prospector-cone-control",
+  x: 0.465,
+  y: 0.500,
+  w: 0.065,
+  h: 0.100,
+});
+
+// Electron nativeImage bitmaps contain four bytes per pixel. The first three bytes are the color
+// channels (their RGB/BGR order is deliberately irrelevant here) and the fourth is alpha. Star
+// Citizen's cone control has both saturated cyan/yellow strokes and bright label pixels. Requiring
+// both densities keeps blue space, dark asteroids, and the normal center reticle from opening the
+// expensive mining OCR state machine.
+function scoreScanModeHudBitmap(bitmap) {
+  const pixels = Math.floor((bitmap?.length || 0) / 4);
+  if (!pixels) {
+    return { active: false, confidence: 0, hudDensity: 0, brightDensity: 0 };
+  }
+
+  let hudPixels = 0;
+  let brightPixels = 0;
+  for (let offset = 0; offset + 3 < bitmap.length; offset += 4) {
+    const c0 = bitmap[offset];
+    const c1 = bitmap[offset + 1];
+    const c2 = bitmap[offset + 2];
+    const high = Math.max(c0, c1, c2);
+    const low = Math.min(c0, c1, c2);
+    const saturatedHud = high >= 100 && high - low >= 26;
+    const paleHud = low >= 135;
+    if (saturatedHud || paleHud) hudPixels += 1;
+    if (high >= 145) brightPixels += 1;
+  }
+
+  const hudDensity = hudPixels / pixels;
+  const brightDensity = brightPixels / pixels;
+  const active = hudDensity >= 0.012 && brightDensity >= 0.0075;
+  const hudScore = Math.max(0, Math.min(1, (hudDensity - 0.004) / 0.016));
+  const brightScore = Math.max(0, Math.min(1, (brightDensity - 0.0015) / 0.0125));
+  return {
+    active,
+    confidence: active ? Math.round(Math.min(hudScore, brightScore) * 100) : 0,
+    hudDensity: Number(hudDensity.toFixed(5)),
+    brightDensity: Number(brightDensity.toFixed(5)),
+  };
+}
+
+module.exports = { SCAN_MODE_HUD_GATE_ROI, scoreScanModeHudBitmap };
